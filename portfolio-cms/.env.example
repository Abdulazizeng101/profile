# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development:  cp .env.example .env.local
# Never commit .env.local or any file containing real credentials.
# On Vercel, set the same variables in Project Settings -> Environment Variables.
# -----------------------------------------------------------------------------

# --- Required -----------------------------------------------------------------

# PostgreSQL connection string.
# Local (docker compose up -d):  postgres://portfolio:portfolio@localhost:5432/portfolio
# Neon: use the *pooled* connection string (host contains "-pooler") with ?sslmode=require
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Public base URL of the site, no trailing slash. Used for canonical URLs, the
# sitemap, Open Graph tags and same-origin checks.
SITE_URL=http://localhost:3000

# Random secret (at least 32 characters) used to sign contact-form tokens and
# hash IP addresses for rate limiting. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-me-with-a-long-random-string-of-32-plus-chars

# --- File storage -------------------------------------------------------------

# "local" stores uploads on disk (development, or a VPS with a persistent volume).
# "s3" stores uploads in any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO).
# Vercel's filesystem is not persistent, so production on Vercel must use "s3".
STORAGE_DRIVER=local

# local driver: directory for uploaded files (outside /public; served by /media/*).
LOCAL_STORAGE_DIR=./storage

# s3 driver (Cloudflare R2 example):
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://media.your-domain.com   (R2 custom domain, or the r2.dev URL for testing)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Maximum upload size in megabytes. Vercel functions accept request bodies up to
# about 4.5 MB, so keep this at 4 there. Large photos are resized in the browser
# before upload, so this rarely matters for images.
MAX_UPLOAD_MB=4

# --- Contact form notifications (optional) -------------------------------------
# Messages are always saved to the dashboard inbox. Fill these in to also get an
# email for each new message. Any SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_TO=

# --- Cloudflare Turnstile (optional extra spam protection) ----------------------
# The form already uses a honeypot, a signed timing check and rate limiting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Advanced (optional) ------------------------------------------------------

# Request header that carries the client IP, used for rate limiting.
# Vercel sets x-forwarded-for itself, so keep the default there. Behind your own
# reverse proxy (VPS), have the proxy SET X-Real-IP and use x-real-ip here
# (see README > Deployment > Option B).
TRUSTED_IP_HEADER=x-forwarded-for

# Database pool size per server instance.
DATABASE_POOL_MAX=5

# --- Tests ----------------------------------------------------------------------
# Vitest reads TEST_DATABASE_URL from .env.test (committed; local test database).
# Playwright uses E2E_DATABASE_URL, defaulting to the local portfolio_e2e database.
